SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
AUTH_SECRET=change-this-64-char-random-secret
# Cloudflare Turnstile captcha. Set both keys together.
# Required in production. Do not use Cloudflare test keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADl7nM8RNT-qeW3H
TURNSTILE_SECRET_KEY=
# Real email delivery for registration codes. Use your SMTP provider credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Optional strict mode. Empty = use built-in known executor User-Agent allowlist.
# Example strict value: Roblox|HttpGet|HttpService
RAW_USER_AGENT_REGEX=
# Default true: unknown/minimal executor HTTP clients are allowed (browsers are still blocked via request headers).
# Set to false for strict deny-by-default (only recognised executor User-Agents allowed).
RAW_ALLOW_UNKNOWN_CLIENTS=true
# Only set to true when the app is deployed behind Cloudflare's proxy.
# When false (default), the spoofable cf-connecting-ip header is ignored for rate limiting.
TRUST_CF_CONNECTING_IP=false
